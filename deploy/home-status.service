[Unit]
Description=Home Status page (Raspberry Pi / network / Tailscale / Nextcloud)
After=network-online.target
# 何度落ちても再起動をあきらめない
StartLimitIntervalSec=0

[Service]
Type=simple
# リポジトリを ~/home-status 以外に置いたときは、下の 3 か所のパスを書き換える
WorkingDirectory=%h/home-status
EnvironmentFile=-%h/home-status/.env
# public: LAN 閲覧用 / admin: Tailscale Serve (https:8443) 経由の操作用 / tunnel: Cloudflare Tunnel 用
ExecStart=/usr/bin/python3 -u %h/home-status/src/server.py --public 0.0.0.0:8090 --admin 127.0.0.1:8092 --tunnel 127.0.0.1:8096
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
