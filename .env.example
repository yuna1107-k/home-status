# Home Status の設定（このファイルを .env にコピーして使う。.env はコミットしない）

# ---- サイト ----
# サイトのホスト名（Cloudflare Tunnel で公開する名前）。パスキーはこのホスト名に結び付く
PASSKEY_RP_ID=status.example.com
# パスキーでログインしたセッションの長さ（秒）
# PASSKEY_SESSION_SECONDS=43200

# ---- Cloudflare Access（サイトの入口） ----
# Zero Trust のチームドメイン（例: myteam.cloudflareaccess.com）。tools/cf_access_setup.py が自動で書く
CF_ACCESS_TEAM_DOMAIN=
# Access アプリケーションの「Application Audience (AUD) Tag」。tools/cf_access_setup.py が自動で書く
CF_ACCESS_AUD=
# 操作を許可するメールアドレス（カンマ区切り）
CF_ACCESS_ALLOWED_EMAILS=you@example.com

# ---- Cloudflare D1（記録の保存先。省略可。未設定なら手元にためておく） ----
# アカウント ID と D1 データベースの ID（tools/cloud_setup.py が自動で書く）
CF_ACCOUNT_ID=
D1_DATABASE_ID=
# API トークンのファイル。既定は ~/.cloudflared/api-token
# CF_API_TOKEN_FILE=
# D1 を作るときの場所のヒント（apac / weur / enam など。省略可）
# D1_LOCATION_HINT=
# 見張りの Worker が通知に書く時刻のタイムゾーン（既定 Asia/Tokyo）
# TIME_ZONE=Asia/Tokyo

# ---- 監視する対象 ----
# ディスク（表示名=マウント先 をカンマ区切り）
DISKS=System=/
# ネットワークのインターフェース
# NET_IFACE=eth0
# インターネットの疎通確認に ping する相手
# INTERNET_HOST=1.1.1.1
# 名前解決の確認に使うホスト名
# DNS_TEST_NAME=www.google.com
# サービスのページに追加で表示する systemd のユニット（カンマ区切り）
# EXTRA_SERVICES=apache2
# SMART を読むディスク（カンマ区切り。deploy/home-status-smartctl.sudoers と揃える）
# SMART_DISKS=sda
# バックアップを置いているディレクトリ（一番新しいファイルの時刻を表示する。空なら未設定）
# BACKUP_DIR=/mnt/backup

# ---- Nextcloud（Docker Compose で動かしている場合） ----
# NEXTCLOUD_URL=http://127.0.0.1:8080/status.php
# NEXTCLOUD_COMPOSE_PROJECT=nextcloud
# NEXTCLOUD_APP_CONTAINER=nextcloud-app-1
# NEXTCLOUD_DB_CONTAINER=nextcloud-db-1
# NEXTCLOUD_REDIS_CONTAINER=nextcloud-redis-1
# Nextcloud のデータを置いているマウント先（使用量を表示する）
# NEXTCLOUD_DATA_DIR=
